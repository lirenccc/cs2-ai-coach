CS2_COACH_SESSION_TOKEN=replace-for-local-dev
CS2_COACH_ANALYZER_HOST=127.0.0.1
CS2_COACH_ANALYZER_PORT=8765
CS2_COACH_DB_PATH=runtime/app.db
CS2_COACH_EXTRACT_ROOT=runtime/extracted

# Backend-only OpenAI credentials (never put these in the renderer).
CS2_COACH_OPENAI_API_KEY=
# Optional SDK fallback used only when CS2_COACH_OPENAI_API_KEY is unset.
OPENAI_API_KEY=
# Optional OpenAI-compatible relay/base URL (required for many GPT 中转).
CS2_COACH_OPENAI_BASE_URL=
OPENAI_BASE_URL=
CS2_COACH_AI_MODEL=gpt-4o-mini
CS2_COACH_AI_IMAGE_DETAIL=auto

# Opt-in real provider smoke (never enabled in normal CI).
CS2_COACH_AI_REAL_SMOKE=0
CS2_COACH_AI_SMOKE_FRAME=
CS2_COACH_AI_SMOKE_WRITE_FIXTURE=0
