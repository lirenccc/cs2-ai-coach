# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.egg-info/
.eggs/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Rust / Tauri
**/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/

# Runtime (local match data, captures, logs)
runtime/**
!runtime/.gitkeep
services/analyzer/runtime/

# Private demos / archives (never commit bytes or absolute local fixture trees)
*.dem
*.dem.gz
*.dem.zip
*.vdm
private/
local/private/
fixtures/private/
demos/

# Local app DBs outside runtime/ (runtime/** already ignored)
*.sqlite
*.db
!fixtures/**/*.json

# Local capture / AI smoke frames (redacted JSON/docs fixtures stay tracked)
captures/
smoke_frames/
**/*unredacted*.png
**/*unredacted*.jpg
**/*unredacted*.jpeg
**/*unredacted*.webp
**/*private*.png
**/*private*.jpg

# IDE / OS
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Logs / temp
*.log
tmp/
temp/
.cache/
pytest-cache-files-*/

# Python tooling
.python-version
uv.lock
